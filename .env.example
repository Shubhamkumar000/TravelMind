# OpenAI API Key (Optional)
# Get your API key from: https://platform.openai.com/api-keys
#
# Note: Variables in Vite must be prefixed with VITE_ to be exposed to the client
VITE_OPENAI_API_KEY=sk-your-api-key-here

# Alternative: You can also set the API key through the UI Settings dialog
# The key will be stored in browser localStorage instead
